<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E0E12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="所有者占位器"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="零权限空壳：不做任何事，只占住系统的 owner 槽位，让别人抢不走。"
            android:textColor="#FF8A8A9A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FF181820"
            android:padding="14dp"
            android:textColor="#FFE0E0F0"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="复制设置命令（在电脑上执行）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="移除保护"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="占位器一旦生效，卸载会被系统拒绝；只有输入下面设置的 PIN 才能解除。请务必记住它。"
            android:textColor="#FF8A8A9A"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSetPin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="设置/修改移除 PIN" />

        <Button
            android:id="@+id/btnRelease"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="输入 PIN 解除占位（可卸载）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="可选：更硬的一层"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchDo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="同时占用设备所有者（DO）"
            android:textColor="#FFE0E0F0"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnInstallBlock"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="禁止新应用安装：关" />

        <Button
            android:id="@+id/btnDebug"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="关闭/恢复 USB 与无线调试" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textColor="#FF6A6A7A"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>


