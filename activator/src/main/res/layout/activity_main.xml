<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E0E12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="占位激活器"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="通过本机无线调试（ADB 配对）自动完成：临时禁用账号提供者 → 设置所有者 → 立即恢复。全程不删除账号、不注销登录。"
            android:textColor="#FF8A8A9A"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. 手机设置 → 开发者选项 → 无线调试 → 打开\n2. 点「使用配对码配对设备」→ 对话框别关（端口会自动发现）\n3. 只需把 6 位配对码填进下面，端口全自动"
            android:textColor="#FFB0B0C0"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etPairPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="配对端口（自动发现，可手填）"
            android:inputType="number"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF666677" />

        <EditText
            android:id="@+id/etPairCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="6 位配对码"
            android:inputType="number"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF666677" />

        <EditText
            android:id="@+id/etConnPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="连接端口（自动发现，可手填）"
            android:inputType="number"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF666677" />

        <Switch
            android:id="@+id/swDo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="目标：设备所有者 DO（默认占 Profile Owner）"
            android:textColor="#FFE0E0F0"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:text="一键配对并占位" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="只测试连接（不修改任何东西）" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FF15151C"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="等待操作…"
            android:textColor="#FFB8D8B8"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>

